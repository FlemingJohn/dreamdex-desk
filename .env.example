# DreamDEX / Somnia — used once the app reads live chain data.
SOMNIA_NETWORK=testnet
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_VENUE_ID=

# Signing key for approved trades. Testnet only.
TRADING_PRIVATE_KEY=
